{
  "name": "@0xsharon/synco",
  "version": "1.0.0",
  "description": "High-performance synchronized lyrics (.lrc) engine for Node.js and the terminal",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "synco": "dist/cli.cjs",
    "syncedlyrics": "dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/index.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "synco",
    "syncedlyrics",
    "lrc",
    "lyrics",
    "synchronized-lyrics",
    "music",
    "karaoke",
    "lrclib",
    "musixmatch",
    "megalobiz",
    "netease",
    "genius"
  ],
  "author": "0xSHARON",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xSHARON/synco.git"
  },
  "bugs": {
    "url": "https://github.com/0xSHARON/synco/issues"
  },
  "homepage": "https://github.com/0xSHARON/synco#readme",
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
